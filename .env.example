# เลือกผู้ให้บริการ AI: anthropic | openai | gemini | ollama | lmstudio | custom
THDOCS_LLM=anthropic
# ชื่อโมเดล (anthropic มีค่าเริ่มต้น; ผู้ให้บริการอื่นต้องระบุ เช่น ollama: qwen3.6:35b-a3b-q4_K_M)
THDOCS_LLM_MODEL=
# custom / vllm / ตัวอื่นที่เป็น OpenAI-compatible
THDOCS_LLM_BASE_URL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# เปิดสาธารณะด้วย docker compose --profile public (Caddy ออกใบรับรอง HTTPS ให้เอง ต้องชี้ DNS มาที่เครื่องนี้ก่อน)
THDOCS_DOMAIN=
THDOCS_PUBLIC_URL=
